{
  "expo": {
    "name": "Spent",
    "slug": "spent-actual",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "com.googleusercontent.apps.820527515652-3ap73pd55flp82elvtsbpct1rjk23n3o",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.clchen5.spent",
      "backgroundModes": [
        "fetch",
        "location"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Spent tracks your location to detect places you visit and create spending flashcards.",
        "NSLocationAlwaysUsageDescription": "Spent tracks your location in the background to detect places you visit.",
        "NSLocationWhenInUseUsageDescription": "Spent uses your location to detect nearby places."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ],
      "package": "com.clchen5.spent"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Spent tracks your location to detect places you visit and create spending flashcards.",
          "locationAlwaysPermission": "Spent tracks your location in the background to detect places you visit.",
          "locationWhenInUsePermission": "Spent uses your location to detect nearby places.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "googleClientId": "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",
      "router": {},
      "eas": {
        "projectId": "0de29e12-a83a-41d0-aadb-3d41727af2ad"
      }
    },
    "owner": "clchen5"
  }
}
